{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gld-blocks/featured-properties",
  "version": "0.1.0",
  "title": "Featured Properties",
  "category": "theme",
  "icon": "building",
  "description": "Displays selected featured properties.",
  "textdomain": "gld-blocks",
  "attributes": {
    "propertyTypes": {
      "type": "array",
      "default": []
    },
    "displayAddress": {
      "type": "boolean",
      "default": true
    },
    "displayType": {
      "type": "boolean",
      "default": true
    },
    "displaySize": {
      "type": "boolean",
      "default": true
    },
    "displayPrice": {
      "type": "boolean",
      "default": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}